// PGTD · Plataforma de Gestión de la Transformación Digital — Algoritmo T
// Motor: SQLite local vía Prisma (archivo var/pgtd.db) — sin servicios
// externos; el mismo esquema migra a PostgreSQL cambiando el datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Identidad ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("DIRECTIVO")   // CONSULTOR | LIDER | RESPONSABLE | DIRECTIVO
  line          Int?      // 1..4 si es RESPONSABLE
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  active        Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Institución ─────────────────────────────────────────────────────────────

model Institution {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  shortName  String
  city       String
  department String
  logoUrl    String?
  active     Boolean @default(true)

  users        User[]
  assessments  Assessment[]
  capabilities Capability[]
  kpis         Kpi[]
  initiatives  Initiative[]
  createdAt    DateTime @default(now())
}

// ─── Gobierno del modelo: responsables y Cuadro de Mando Integral ───────────

model Responsible {
  id           String @id            // R01…
  cargo        String
  dependencia  String
  rolPlataforma String               // LIDER | RESPONSABLE | APORTA | CONSULTA
}

model CmiObjective {
  id          String @id             // OE-01…
  perspective String                 // impacto | sostenibilidad | comunidad | procesos | innovacion
  name        String
  kpis        Json                   // códigos de KPI asociados
  line        Int?
}

// ─── Gestor de proyectos ─────────────────────────────────────────────────────

model Person {
  id            String @id            // P01…
  name          String
  cargo         String
  dependencia   String
  email         String @unique
  responsibleId String                // enlaza con Responsible
  tasks         ProjectTask[]
}

model ProjectTask {
  id               String   @id       // T-i1-01…
  initiativeId     String?            // Initiative.id (cuid) — se resuelve en seed
  iniCode          String             // i1… (código estable del catálogo)
  title            String
  desc             String?            // alcance verificable de la actividad
  assigneeId       String             // responsable principal
  coAssigneeIds    Json?                  // corresponsables (Person.id[])
  assignee         Person   @relation(fields: [assigneeId], references: [id])
  start            DateTime
  due              DateTime
  status           String   // POR_HACER | EN_CURSO | EN_REVISION | HECHA | BLOQUEADA
  requiresEvidence Boolean  @default(false)
  evidenceIds      Json?    // EV-xx
  dependsOn        Json?    // ids de tareas
  note             String?

  @@index([iniCode, status])
  @@index([assigneeId, due])
}

model TaskComment {
  id       Int      @id @default(autoincrement())
  taskId   String
  author   String
  role     String
  text     String
  at       DateTime @default(now())

  @@index([taskId, at])
}

model FileAsset {
  id         String   @id            // EV-U01…
  taskId     String
  title      String
  kind       String
  fileName   String
  filePath   String                  // clave local o de R2
  size       Int
  mime       String
  uploadedBy String
  status     String   @default("PENDIENTE")
  at         DateTime @default(now())

  @@index([taskId])
}

// ─── Portafolio académico ────────────────────────────────────────────────────

model Program {
  id             String  @id @default(cuid())
  institutionId  String
  code           String
  name           String
  level          String  // Pregrado | Tecnología | Especialización | Maestría
  faculty        String
  campus         String
  modality       String  // Presencial | Híbrida | Virtual
  students       Int
  virtualCredits Int     // % de créditos con componente virtual
  accredited     Boolean @default(false)
  saberPro       Int?
  dropout        Float
  breakEven      Boolean @default(true)

  @@unique([institutionId, code, campus])
  @@index([institutionId, faculty])
}

// ─── Instrumento y mediciones de madurez ────────────────────────────────────

model MaturityModel {
  id          String   @id @default(cuid())
  version     String   @unique // p.ej. "2026.1"
  name        String
  // líneas 4.1–4.4 y dimensiones como catálogo JSON versionado:
  // lines: [{n:1, code:"4.1", name, color}], dimensions: [{key, name}]
  lines       Json
  dimensions  Json
  active      Boolean  @default(true)
  assessments Assessment[]
  createdAt   DateTime @default(now())
}

model Assessment {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  modelId       String
  model         MaturityModel @relation(fields: [modelId], references: [id])
  label         String   // "Línea base · Fase 0"
  periodStart   DateTime
  periodEnd     DateTime
  status        String   @default("DRAFT")       // DRAFT | EN_CAPTURA | PUBLICADA
  publishedAt   DateTime?
  scores        Score[]
  createdAt     DateTime @default(now())

  @@index([institutionId, publishedAt(sort: Desc)])
}

model Score {
  id           String  @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  line         Int     // 1..4
  dimension    String  // organizacional | misional | tecnologica | datos
  value        Float   // 1..5
  target       Float?  // meta a 24 meses
  note         String?
  evidences    Evidence[]

  @@unique([assessmentId, line, dimension])
}

model Evidence {
  id         String   @id @default(cuid())
  scoreId    String
  score      Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  title      String
  kind       String?  // Documento | Acta | Normativa | Informe | Sistema | Encuesta
  status     String   @default("PENDIENTE") // VERIFICADA | PENDIENTE
  source     String?  // dependencia que la aporta
  fileUrl    String?  // objeto en R2
  note       String?
  capturedBy String?
  capturedAt DateTime @default(now())
}

// ─── Capacidades y mapa estratégico ─────────────────────────────────────────

model Capability {
  id            String  @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  line          Int
  name          String
  description   String?
  currentLevel  Float
  targetLevel   Float
  ownerRole     String?
  objective     String? // objetivo institucional al que sirve
  initiatives   Initiative[]

  @@index([institutionId, line])
}

// ─── Indicadores ─────────────────────────────────────────────────────────────

model Kpi {
  id            String  @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  line          Int
  code          String
  name          String
  definition    String?
  formula       String?
  cmiObjective  String? // OE-xx
  unit          String  // %, número, razón…
  source        String? // sistema o dependencia que produce el dato
  ownerRole     String?
  frequency     String   @default("TRIMESTRAL")  // MENSUAL | TRIMESTRAL | SEMESTRAL | ANUAL
  baseline      Float?
  target        Float?
  goodDirection String  @default("up") // up | down
  values        KpiValue[]
  initiatives   Initiative[]

  @@unique([institutionId, code])
  @@index([institutionId, line])
}

model KpiValue {
  id        String   @id @default(cuid())
  kpiId     String
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  period    String   // "2026-T1"
  value     Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([kpiId, period])
}

// ─── Roadmap e iniciativas ───────────────────────────────────────────────────

model Initiative {
  id             String   @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  line           Int
  name           String
  description    String?
  subsistema     String?  // Administrativo | Formación | Investigación | Proyección social | Bienestar
  cmiObjective   String?  // OE-xx
  metaResultado  String?
  actions        Json?    // [{name, meta, status, quarter}]
  log            Json?    // [{date, type, text}]
  nextMilestone  Json?    // {date, text}
  horizon        String                            // CORTO | MEDIANO
  impact         Int      // 1..5
  feasibility    Int      // 1..5
  status         String   @default("PLANEADA")   // PLANEADA | EN_CURSO | EN_RIESGO | COMPLETADA
  ownerRole      String?
  startQuarter   String?  // "2026-T3"
  endQuarter     String?
  budgetPlanned   Float   @default(0)
  budgetCommitted Float   @default(0)
  budgetExecuted  Float   @default(0)
  progress       Int      @default(0) // %
  capabilityId   String?
  capability     Capability? @relation(fields: [capabilityId], references: [id])
  kpiId          String?
  kpi            Kpi?     @relation(fields: [kpiId], references: [id])
  successFactors SuccessFactor[]

  @@index([institutionId, horizon])
}

model SuccessFactor {
  id           String   @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  state        String   @default("VERDE")         // VERDE | AMBAR | ROJO
  history      Json?    // [{period:"jun", state:"VERDE"}]
  note         String?
  reviewedAt   DateTime @default(now())
}
